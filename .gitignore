# Node modules
node_modules/

# Local environment variables
.env
.env.local
.env.*.local

# Next.js build output
.next/
.next*/
out/

# Production build
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local archives and temporary artifacts
*.tgz
tmp/
NUL

# Development cryptographic private material. Public trust anchors may be
# distributed separately; private keys, bundles and TSA state never belong in Git.
*.key
*.key.pem
*.p12
*.pfx
infra/tsa/data/

# Google Application Default Credentials and service-account exports are local
# machine state. Docubox authenticates with ADC/impersonation, never JSON keys.
application_default_credentials.json
*service-account*.json
*service_account*.json
gcp-credentials*.json
google-credentials*.json
.docubox/crypto/

# OS-specific files
.DS_Store
Thumbs.db

# Vercel deployment
.vercel/

# Optional: if using TypeScript
*.tsbuildinfo

# Optional: if using testing tools
coverage/
jest-test-results.json

# Optional: if using IDEs
.vscode/
.idea/

# Optional: if using TurboRepo or monorepo
turbo/
