# Supabase (valores publicos del proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (solo backend; nunca usar prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# URL canonica de Docubox
NEXT_PUBLIC_SITE_URL=https://docubox-docubox.vercel.app

# CORS de Edge Functions privilegiadas. En produccion define solo dominios
# propios separados por comas; no incluyas localhost ni uses NEXT_PUBLIC_.
DOCUBOX_ALLOWED_ORIGINS=https://docubox-docubox.vercel.app,https://docubox.mx

# Cifrado de credenciales de organizacion (backend only). Debe ser una clave
# dedicada de 32 bytes codificada en base64 y nunca reutilizar service_role.
ORGANIZATION_CREDENTIAL_ENCRYPTION_KEY=

# Correo y OTP
RESEND_API_KEY=
RESEND_FROM_EMAIL=Docubox <noreply@docubox.com.mx>
RESEND_REPLY_TO_EMAIL=soporte@docubox.com.mx

# Docubox Colabora: analisis antimalware fail-closed
COLABORA_MALWARE_SCAN_URL=
COLABORA_MALWARE_SCAN_TOKEN=
# Alternativa ya soportada: MetaDefender Cloud
METADEFENDER_API_KEY=

# Procesadores programados (solo backend)
CRON_SECRET=
# Docubox Certifica (backend only; never prefix secrets with NEXT_PUBLIC_)
CERTIFICA_PSC_MODE=sandbox
CERTIFICA_PSC_BASE_URL=
CERTIFICA_PSC_API_TOKEN=
CERTIFICA_PSC_WEBHOOK_SECRET=

# TSA RFC 3161 de desarrollo (solo backend; nunca usar prefijo NEXT_PUBLIC_)
# La TSA es independiente de NOM-151 y de la llave de firma documental.
PADES_REQUIRED_LEVEL=B-B
DOCUBOX_TSA_PROVIDER=rfc3161
DOCUBOX_TSA_URL=
DOCUBOX_TSA_INTERNAL_TOKEN=
DOCUBOX_TSA_USERNAME=
DOCUBOX_TSA_PASSWORD=

# NOM-151 (solo backend). RFC 3161 y NOM-151 son servicios independientes.
# Declarar el entorno contractual real. `production` exige endpoint productivo
# explícito y trust bundle completo; nunca se infiere por una respuesta válida.
NOM151_ENVIRONMENT=development
NOM151_NUBARIUM_ENDPOINT=https://firma.nubarium.com/nom151/v1/obtener-nom151
NOM151_PRODUCTION_ENDPOINT=
NOM151_PROVIDER_TIMEOUT_MS=45000
NOM151_PROVIDER_MAX_RETRIES=3
NUBARIUM_USER=
NUBARIUM_PASS=
# Trust público versionado del PSC. La emisión no descarga anclas dinámicamente.
NOM151_PSC_TRUST_MANIFEST_PATH=infra/nom151/trust/manifest.json
NOM151_PSC_TRUST_ROOT_PATH=infra/nom151/trust/roots/ACR2_SE.pem
NOM151_PSC_TRUST_ROOT_SHA256=b2f258c42c3066c54c3d9bbcb9a4c16bed4e7b74f302643a11af26961e09c720
NOM151_PSC_TRUST_BUNDLE_VERSION=1
NOM151_PSC_TRUST_INTERMEDIATES_PATH=
DOCUBOX_TSA_TOKEN=
DOCUBOX_TSA_POLICY_OID=1.3.6.1.4.1.55555.1.1
DOCUBOX_TSA_DIGEST_ALGORITHM=sha256
DOCUBOX_TSA_CERTIFICATE=
DOCUBOX_TSA_CERTIFICATE_PATH=
DOCUBOX_TSA_CHAIN=
DOCUBOX_TSA_CHAIN_PATH=
DOCUBOX_TSA_ROOT_CA=
DOCUBOX_TSA_TRUST_ROOT_PATH=
DOCUBOX_TSA_TIMEOUT_MS=8000

# TSA RFC 3161 externas gratuitas. Los certificados son publicos y se cargan
# desde bundles versionados; nunca se descargan anclas de confianza al firmar.
# No configures una policy OID salvo que Docubox deba exigir una concreta.
TSA_POLICY=external-free
DOCUBOX_TSA_TRUST_BUNDLE_ROOT=infra/tsa/trust-bundles
FREETSA_TRUST_BUNDLE_PATH=infra/tsa/trust-bundles/freetsa/v1
FREETSA_ENDPOINT_ID=freetsa-official-tsr
FREETSA_TIMEOUT_MS=8000
FREETSA_RATE_LIMIT_PER_MINUTE=30
OPEN_TSA_TRUST_BUNDLE_PATH=infra/tsa/trust-bundles/open-tsa/v1
OPEN_TSA_ENDPOINT_ID=open-tsa-official-tsr
OPEN_TSA_TIMEOUT_MS=8000
OPEN_TSA_RATE_LIMIT_PER_MINUTE=60
EXTERNAL_TSA_RETRY_DELAY_MS=250
EXTERNAL_TSA_CIRCUIT_FAILURE_THRESHOLD=5
EXTERNAL_TSA_CIRCUIT_COOLDOWN_MS=30000

# Activa la ejecucion integral solo cuando KMS, X.509, PAdES y TSA reales
# esten configurados en el backend. Nunca exponer esta bandera al navegador.
CRYPTO_CERTIFICATION_E2E_ENABLED=false

# Seleccion de proveedores criptograficos. Produccion no tiene fallback al
# firmador heredado ni al entorno de desarrollo y debe habilitarse despues del
# rollout controlado y las pruebas de integracion.
CRYPTO_PROVIDER_MODE=development
PRODUCTION_CERTIFICATION_ENABLED=false

# Autenticacion portable para Google Cloud (solo backend).
# local_adc: desarrollo local; workload_identity: hosting externo (Vercel,
# AWS, Azure u otro); gcp_native: Cloud Run/GKE/Compute con identidad nativa.
# En produccion GCP_AUTH_MODE es obligatorio. Nunca configures JSON de Service
# Account, private keys ni estas variables con prefijo NEXT_PUBLIC_.
GCP_AUTH_MODE=local_adc
GCP_PROJECT_ID=project-702d9de4-d29c-49f2-82c
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_PROVIDER_ID=
GCP_WIF_AUDIENCE=
# JWT es el valor normal para OIDC. AWS podra configurar su token type firmado.
GCP_WIF_SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:jwt
HOSTING_PROVIDER=

# Google Cloud KMS (solo backend). El proveedor recibe un AuthClient de la capa
# anterior y no conoce el hosting. No guardes archivos JSON en el proyecto.
DOCUBOX_KMS_PROVIDER=gcp
GOOGLE_CLOUD_PROJECT_ID=project-702d9de4-d29c-49f2-82c
GOOGLE_KMS_LOCATION=us-east1
GOOGLE_KMS_KEY_RING=docubox-pades
GOOGLE_KMS_KEY_NAME=docubox-pades-signing
GOOGLE_KMS_KEY_VERSION=1
GOOGLE_KMS_ALGORITHM=RSA_SIGN_PKCS1_3072_SHA256
GOOGLE_KMS_SERVICE_ACCOUNT=docubox-pades-signer@project-702d9de4-d29c-49f2-82c.iam.gserviceaccount.com

# Google Cloud HSM de produccion (solo backend). PROTECTION_LEVEL=HSM es
# obligatorio y tambien se valida
# contra el valor devuelto por Cloud KMS; no existe fallback a Software.
GOOGLE_KMS_PRODUCTION_PROJECT_ID=project-702d9de4-d29c-49f2-82c
GOOGLE_KMS_PRODUCTION_LOCATION=us-east1
GOOGLE_KMS_PRODUCTION_KEY_RING=docubox-pades-prod
GOOGLE_KMS_PRODUCTION_KEY_NAME=docubox-pades-production-signing
GOOGLE_KMS_PRODUCTION_KEY_VERSION=1
GOOGLE_KMS_PRODUCTION_ALGORITHM=RSA_SIGN_PKCS1_3072_SHA256
GOOGLE_KMS_PRODUCTION_PROTECTION_LEVEL=HSM
GOOGLE_KMS_PRODUCTION_SERVICE_ACCOUNT=docubox-pades-prod-signer@project-702d9de4-d29c-49f2-82c.iam.gserviceaccount.com

# Certificados publicos de produccion. Configura rutas montadas por el gestor
# de secretos o PEM publico; nunca incluyas la llave privada del certificado.
DOCUBOX_PRODUCTION_SIGNING_CERTIFICATE_PATH=
DOCUBOX_PRODUCTION_SIGNING_CERTIFICATE_PEM=
DOCUBOX_PRODUCTION_SIGNING_CERTIFICATE_CHAIN_PATH=
DOCUBOX_PRODUCTION_SIGNING_CERTIFICATE_CHAIN_PEM=
DOCUBOX_PRODUCTION_TRUST_ROOT_CERTIFICATE_PATH=
DOCUBOX_PRODUCTION_TRUST_ROOT_CERTIFICATE_PEM=
DOCUBOX_PRODUCTION_SIGNING_CERTIFICATE_KEY_ID=
DOCUBOX_PRODUCTION_CERTIFICATE_EXPIRING_SOON_DAYS=30
# Subject del certificado privado de confianza. Completar con la identidad
# legal real antes de generar el certificado; no usar valores de ejemplo.
DOCUBOX_PRODUCTION_CERTIFICATE_COMMON_NAME=
DOCUBOX_PRODUCTION_CERTIFICATE_ORGANIZATION=
DOCUBOX_PRODUCTION_CERTIFICATE_ORGANIZATIONAL_UNIT=
DOCUBOX_PRODUCTION_CERTIFICATE_COUNTRY=MX

# TSA comercial o institucional de produccion, separada de NOM-151.
DOCUBOX_PRODUCTION_TSA_URL=
DOCUBOX_PRODUCTION_TSA_SERVICE_TOKEN=
DOCUBOX_PRODUCTION_TSA_POLICY_OID=
DOCUBOX_PRODUCTION_TSA_CERTIFICATE_PATH=
DOCUBOX_PRODUCTION_TSA_TRUST_ROOT_PATH=
DOCUBOX_PRODUCTION_TSA_TIMEOUT_MS=8000
