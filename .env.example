# Supabase (valores publicos del proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (solo backend; nunca usar prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# URL canonica de Docubox
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# Correo y OTP
RESEND_API_KEY=
RESEND_FROM_EMAIL=Docubox <noreply@docubox.com.mx>
RESEND_REPLY_TO_EMAIL=soporte@docubox.com.mx

# Docubox Colabora: analisis antimalware fail-closed
COLABORA_MALWARE_SCAN_URL=
COLABORA_MALWARE_SCAN_TOKEN=
# Alternativa ya soportada: MetaDefender Cloud
METADEFENDER_API_KEY=

# Procesadores programados (solo backend)
CRON_SECRET=
# Docubox Certifica (backend only; never prefix secrets with NEXT_PUBLIC_)
CERTIFICA_PSC_MODE=sandbox
CERTIFICA_PSC_BASE_URL=
CERTIFICA_PSC_API_TOKEN=
CERTIFICA_PSC_WEBHOOK_SECRET=
