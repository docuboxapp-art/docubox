{
  "name": "firmamax",
  "version": "0.1.0",
  "private": true,
  "rocketCritical": {
    "dependencies": [
      "next",
      "react",
      "react-dom",
      "@dhiwise/component-tagger",
      "@tailwindcss/typography",
      "recharts"
    ],
    "devDependencies": [
      "typescript",
      "@types/node",
      "@types/react",
      "@types/react-dom",
      "@typescript-eslint/eslint-plugin",
      "@typescript-eslint/parser",
      "eslint-config-next",
      "tailwindcss",
      "autoprefixer",
      "postcss",
      "eslint",
      "prettier",
      "@netlify/plugin-nextjs"
    ],
    "scripts": [
      "dev",
      "build",
      "start",
      "lint",
      "lint:fix",
      "format",
      "serve",
      "type-check"
    ],
    "warning": "🚨 CRITICAL: DO NOT REMOVE OR MODIFY ABOVE DEPENDENCIES - Required for Next.js 16 TypeScript app functionality"
  },
  "scripts": {
    "dev": "next dev --webpack -p 4028",
    "build": "next build --webpack",
    "start": "next dev --webpack -p 4028",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "next start",
    "test:kms:gcp": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-google-kms.ts",
    "test:gcp:portable-auth": "node --test tests/google-cloud-auth-provider.test.mjs tests/google-cloud-kms-provider.test.mjs",
    "test:pdf-font-embedding": "node --test tests/pdf-font-embedding.test.mjs",
    "test:document-encryption": "node --test tests/document-encryption.test.mjs",
    "test:kms:document": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-document-encryption-kms.ts",
    "security:reconcile-supabase": "node scripts/generate-supabase-reconciliation.mjs",
    "security:audit-document-encryption": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-document-encryption.ts",
    "test:document-encryption:production-e2e": "esbuild scripts/test-document-encryption-production-e2e.ts --bundle --platform=node --format=esm --packages=external | node --input-type=module",
    "test:crypto-lifecycle-e2e:contract": "node --test tests/crypto-lifecycle-e2e.test.mjs",
    "security:migrate-document-encryption": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-documents-to-encryption.ts",
    "security:migrate-document-encryption-canary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-legacy-document-canary.ts",
    "security:migrate-document-encryption-batch:build": "esbuild scripts/migrate-legacy-document-batch.ts --bundle --platform=node --format=esm --packages=external --outfile=.tmp/migrate-legacy-document-batch.mjs",
    "security:migrate-document-encryption-batch": "npm run security:migrate-document-encryption-batch:build --silent && node .tmp/migrate-legacy-document-batch.mjs",
    "security:audit-final-encryption-closure": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/audit-final-encryption-closure.ts",
    "security:migrate-final-encryption-closure:build": "esbuild scripts/migrate-final-encryption-closure-batch.ts --bundle --platform=node --format=esm --packages=external --outfile=.tmp/migrate-final-encryption-closure-batch.mjs",
    "security:migrate-final-encryption-closure": "npm run security:migrate-final-encryption-closure:build --silent && node .tmp/migrate-final-encryption-closure-batch.mjs",
    "security:finalize-encryption-closure": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/finalize-encryption-closure.ts",
    "security:rewrap-document-keys": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/rewrap-document-keys.ts",
    "test:kms:pades-bb": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-google-kms-pades-bb.ts",
    "test:kms:hsm-production": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-google-hsm-production.ts",
    "diagnose:pades-readiness": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/diagnose-pades-readiness.ts",
    "test:pades:product-real": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-real-document-pades-bb.ts",
    "test:pades:product-real-bt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-real-document-pades-bt.ts",
    "crypto:onboard:external-tsa": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/onboard-external-tsa-trust.ts",
    "test:tsa:external": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-external-tsa.ts",
    "test:nom151:real": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-real-document-nom151.ts",
    "crypto:onboard:nom151-trust": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/onboard-nom151-psc-trust.ts",
    "crypto:bootstrap:gcp-certificate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bootstrap-google-kms-development-certificate.ts",
    "crypto:bootstrap:hsm-production-certificate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bootstrap-google-hsm-production-certificate.ts",
    "type-check": "tsc --noEmit"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@dhiwise/component-tagger": "^1.0.14",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fingerprintjs/fingerprintjs": "5.2.0",
    "@google-cloud/kms": "6.0.0",
