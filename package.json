    "@simplewebauthn/server": "13.3.0",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.100.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-color": "3.29.2",
    "@tiptap/extension-font-family": "3.29.2",
    "@tiptap/extension-highlight": "3.29.2",
    "@tiptap/extension-horizontal-rule": "3.29.2",
    "@tiptap/extension-image": "3.29.2",
    "@tiptap/extension-table": "3.29.2",
    "@tiptap/extension-table-cell": "3.29.2",
    "@tiptap/extension-table-header": "3.29.2",
    "@tiptap/extension-table-row": "3.29.2",
    "@tiptap/extension-text-align": "3.29.2",
    "@tiptap/extension-text-style": "3.29.2",
    "@tiptap/extension-underline": "3.29.2",
    "@tiptap/react": "3.29.2",
    "@tiptap/starter-kit": "3.29.2",
    "@vercel/oidc": "3.8.5",
    "asn1js": "^3.0.10",
    "date-fns": "4.1.0",
    "google-auth-library": "11.0.2",
    "html2canvas": "1.4.1",
    "lodash": "4.18.1",
    "lucide-react": "^0.577.0",
    "next": "16.3.1",
    "otplib": "13.4.0",
    "pdf-lib": "1.17.1",
    "pkijs": "^3.4.0",
    "qrcode": "1.5.4",
    "qrcode.react": "4.2.0",
    "react": "19.0.3",
    "react-datepicker": "9.1.0",
    "react-dom": "19.0.3",
    "react-hook-form": "7.75.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^2.15.2",
    "resend": "^4.0.0",
    "signature_pad": "5.1.3",
    "sonner": "^1.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.5",
    "@netlify/plugin-nextjs": "^5.11.1",
    "@types/html2canvas": "1.0.0",
    "@types/node": "^20",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "autoprefixer": "10.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "postcss": "8.5.26",
    "prettier": "^3.5.3",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
